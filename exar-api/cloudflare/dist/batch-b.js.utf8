async () => {
  const db = "9bd95dca-6c2f-439a-a4d7-53c44a82118b";
  const results = [];
  async function ins(i, c) {
    const r = await cloudflare.request({
      method: "POST",
      path: "/accounts/" + accountId + "/d1/database/" + db + "/query",
      body: { sql: "INSERT INTO _deploy_chunks (i, c) VALUES (?, ?)", params: [i, c] }
    });
    if (!r.success) throw new Error("fail " + i + " " + JSON.stringify(r.errors));
    results.push({ i, len: c.length });
  }
  await ins(4, "");
  await ins(5, "");
  await ins(6, "");
  await ins(7, "");
  return { results };
}